# Next.js selects NODE_ENV. Do not set it manually.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local Docker Postgres. Production uses Supabase's pooled connection.
DATABASE_URL=postgresql://riftwatch:riftwatch@localhost:5432/riftwatch
DATABASE_URL_DIRECT=postgresql://riftwatch:riftwatch@localhost:5432/riftwatch
# Optional local-only target for `pnpm db:restore:verify` when DATABASE_URL is hosted.
DATABASE_URL_RECOVERY=

# `pnpm local:setup` replaces these two placeholders with random local secrets.
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_ENABLE_DEV_PROVIDER=true
ADMIN_EMAIL=admin@riftwatch.com

# Server-only CardTrader token. Required for catalog sync and market scans.
# Never prefix this with NEXT_PUBLIC_ and never commit its value.
CARD_TRADER_AUTH_TOKEN=
CRON_SECRET=replace-with-at-least-32-random-characters

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Operational defaults
SCAN_BATCH_SIZE=50
MAX_ACTIVE_BLUEPRINTS=250
DEFAULT_WATCH_QUOTA=50
