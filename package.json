{
  "name": "riftwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "css:build": "tailwindcss -i src/styles/tailwind.css -o src/app/globals.css --minify",
    "dev": "node scripts/local.mjs dev",
    "dev:app": "pnpm css:build && next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "local:setup": "node scripts/local.mjs setup",
    "local:doctor": "node scripts/local.mjs doctor",
    "local:up": "node scripts/local.mjs up",
    "local:down": "node scripts/local.mjs down",
    "local:restart": "node scripts/local.mjs restart",
    "local:status": "node scripts/local.mjs status",
    "local:logs": "node scripts/local.mjs logs",
    "local:reset": "node scripts/local.mjs reset",
    "db:shell": "node scripts/local.mjs db-shell",
    "cron:catalog": "node scripts/local.mjs cron-catalog",
    "cron:scan": "node scripts/local.mjs cron-scan",
    "docs:check": "node scripts/check-docs.mjs",
    "check": "node scripts/local.mjs check",
    "check:all": "node scripts/local.mjs check-all",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@next/env": "latest",
    "@auth/drizzle-adapter": "latest",
    "@radix-ui/react-avatar": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-label": "latest",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-switch": "latest",
    "@radix-ui/react-tabs": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "date-fns": "latest",
    "drizzle-orm": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "next-auth": "beta",
    "postgres": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "tailwind-merge": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/cli": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "^24.0.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "drizzle-kit": "latest",
    "eslint": "^9.0.0",
    "eslint-config-next": "latest",
    "jsdom": "latest",
    "prettier": "latest",
    "prettier-plugin-tailwindcss": "latest",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "^6.0.0",
    "vitest": "latest"
  }
}
