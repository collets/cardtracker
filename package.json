{
  "name": "riftwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "css:build": "tailwindcss -i src/styles/tailwind.css -o src/app/globals.css --minify",
    "dev": "node scripts/local.mjs dev",
    "dev:app": "pnpm css:build && next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "local:setup": "node scripts/local.mjs setup",
    "local:doctor": "node scripts/local.mjs doctor",
    "local:up": "node scripts/local.mjs up",
    "local:down": "node scripts/local.mjs down",
    "local:restart": "node scripts/local.mjs restart",
    "local:status": "node scripts/local.mjs status",
    "local:logs": "node scripts/local.mjs logs",
    "local:reset": "node scripts/local.mjs reset",
    "db:shell": "node scripts/local.mjs db-shell",
    "cron:catalog": "node scripts/local.mjs cron-catalog",
    "cron:scan": "node scripts/local.mjs cron-scan",
    "prod:check-env": "tsx scripts/production.mts check-env",
    "ops:status": "tsx scripts/production.mts status",
    "db:security-audit": "tsx scripts/production.mts security",
    "smoke:hosted": "tsx scripts/production.mts smoke",
    "market:calibrate": "tsx scripts/calibrate-market.mts",
    "telegram:webhook:set": "tsx scripts/telegram-webhook.mts set",
    "telegram:webhook:status": "tsx scripts/telegram-webhook.mts status",
    "telegram:webhook:delete": "tsx scripts/telegram-webhook.mts delete",
    "docs:check": "node scripts/check-docs.mjs",
    "check": "node scripts/local.mjs check",
    "check:all": "node scripts/local.mjs check-all",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:e2e": "NODE_OPTIONS=--conditions=react-server playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --conditions=react-server src/db/seed.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@next/env": "16.3.0",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
